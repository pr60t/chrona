<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".ChronaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chrona">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Chrona.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dedicated standalone ringing activity for lockscreen and full-screen presentation -->
        <activity
            android:name=".feature.alarms.AlarmRingingActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="com.example.chrona.ringing"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.Chrona" />

        <!-- Authoritative single owner of alarm looping audio and vibration -->
        <service
            android:name=".core.alarm.AlarmAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".core.alarm.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.chrona.ACTION_ALARM_TRIGGER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".feature.stopwatch.StopwatchReceiver"
            android:exported="false" />

        <receiver
            android:name=".feature.timer.TimerReceiver"
            android:exported="false" />

        <!-- World Clock Widget Configuration Activity -->
        <activity
            android:name=".widget.WorldClockConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Chrona">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 1. Analogue Widget Provider -->
        <receiver
            android:name=".widget.AnalogueWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_analogue">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analogue_info" />
        </receiver>

        <!-- 2. Digital Widget Provider -->
        <receiver
            android:name=".widget.DigitalWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_digital">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_digital_info" />
        </receiver>

        <!-- 3. Stacked Widget Provider -->
        <receiver
            android:name=".widget.StackedWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_stacked">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stacked_info" />
        </receiver>

        <!-- 4. Stopwatch Widget Provider -->
        <receiver
            android:name=".widget.StopwatchWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_stopwatch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.chrona.widget.ACTION_STOPWATCH_TOGGLE" />
                <action android:name="com.example.chrona.widget.ACTION_STOPWATCH_RESET" />
                <action android:name="com.example.chrona.widget.ACTION_STOPWATCH_LAP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stopwatch_info" />
        </receiver>

        <!-- 5. World Clock — Pixel Atlas Widget Provider -->
        <receiver
            android:name=".widget.WorldClockAtlasWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_world_clock_atlas">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_world_clock_atlas_info" />
        </receiver>

        <!-- 6. World Clock — Minimal Widget Provider -->
        <receiver
            android:name=".widget.WorldClockMinimalWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_world_clock_minimal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_world_clock_minimal_info" />
        </receiver>

        <!-- 7. World Clock — Pixel Frost Widget Provider -->
        <receiver
            android:name=".widget.WorldClockFrostWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_world_clock_frost">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_world_clock_frost_info" />
        </receiver>
    </application>

</manifest>
